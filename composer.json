{
  "name": "web-db-dev/team-website",
  "description": "Local PHP and Yii2 baseline for the team website course project",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "~8.4.23",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "yiisoft/yii2": "2.0.55"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "config": {
    "platform": {
      "php": "8.4.23"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "smoke": "@php tests/toolchain.php"
  }
}
